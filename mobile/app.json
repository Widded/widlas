{
  "expo": {
    "name": "Edirne Ulaşım",
    "slug": "edirne-ulasim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edirneulasim.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "En yakın otobüs duraklarını bulmak ve canlı rota takibi için konumunuza ihtiyaç duyulur."
      }
    },
    "android": {
      "package": "com.edirneulasim.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "En yakın durakları bulmak için konumunuza ihtiyaç var."
        }
      ]
    ]
  }
}
